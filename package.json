{
  "name": "iva-bitrix24",
  "version": "0.3.0",
  "private": true,
  "description": "Bitrix24 integration plugin for Iva with bounded task reading and managed updates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mamysh/iva-bitrix24.git"
  },
  "bugs": {
